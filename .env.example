APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://practice:practice@localhost:5432/practice
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=local-development-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
BUSINESS_TIMEZONE=Asia/Seoul
RESERVATION_HOLD_TTL_SECONDS=300
REDIS_KEY_PREFIX=practice-server
PAYMENT_PROVIDER=local
LOCAL_PAYMENT_STATE_TTL_SECONDS=86400

# Toss Payments test keys
# PAYMENT_PROVIDER=toss 로 바꾼 뒤 아래 값을 토스페이먼츠 개발자센터의 테스트 키로 채워주세요.
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_BASE_URL=https://api.tosspayments.com
TOSS_PAYMENTS_API_VERSION=2024-06-01
TOSS_PAYMENTS_SUCCESS_URL=http://localhost:8000/?paymentResult=success
TOSS_PAYMENTS_FAIL_URL=http://localhost:8000/?paymentResult=fail
